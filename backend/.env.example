# ============================================================
# AgentGuard402 本地配置模板
# 复制成 .env 后填。默认值已按 anvil 本地链配好, 想跑 Fuji 再改。
# 注意: 这三个私钥只用于测试网演示, 绝不要用主网有钱的钱包。
# ============================================================

# --- 链 ---
# 本地 anvil (默认):
RPC_URL=http://127.0.0.1:8545
# Fuji 测试网:
# RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=31337

# --- 合约地址 (部署后由 contracts/deploy-out.json 自动同步) ---
MOCK_USDC=
REGISTRY=
VAULT=
DEPLOY_BLOCK=0

# --- 三方角色私钥 (只能用测试网临时钱包) ---
# OWNER        : 出钱方, 建策略 + 注资, 需要测试 AVAX 付 gas
# FACILITATOR  : x402 结算中继, 帮 agent 提交交易, 需要测试 AVAX 付 gas
# AGENT        : 被授权的 AI agent, 只签名, 不需要任何 AVAX
OWNER_PRIVATE_KEY=
FACILITATOR_PRIVATE_KEY=
AGENT_PRIVATE_KEY=

# --- 收款方 ---
# MERCHANT: 卖数据的 API 服务方 (会进策略白名单)
# ATTACKER: 演示"未授权收款人"用的地址 (不进白名单)
MERCHANT_PRIVATE_KEY=
MERCHANT_ADDRESS=
ATTACKER_ADDRESS=

# --- 服务端口 ---
PORT=4020
